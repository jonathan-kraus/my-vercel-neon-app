name: Enable Auto-merge Now

on:
  workflow_dispatch:
    inputs:
      pr_number:
        description: 'Pull request number to enable auto-merge for (optional)'
        required: false
  push:

permissions:
  pull-requests: write
  contents: read

jobs:
  enable:
    runs-on: ubuntu-latest
    steps:
      - name: Enable auto-merge for PR
        env:
          GITHUB_API: https://api.github.com/graphql
          REPO_OWNER: jonathan-kraus
          REPO_NAME: my-vercel-neon-app
          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
        run: |
          set -euo pipefail
          # Determine PR number: prefer workflow input, then try to read from GITHUB_EVENT_PATH
          PR_NUMBER="${{ github.event.inputs.pr_number || '' }}"
          if [ -z "$PR_NUMBER" ]; then
            if [ -n "${GITHUB_EVENT_PATH:-}" ] && [ -f "${GITHUB_EVENT_PATH}" ]; then
              PR_NUMBER=$(jq -r '.number // .pull_request.number // .check_suite.pull_requests[0].number // empty' "$GITHUB_EVENT_PATH" 2>/dev/null || true)
            fi
          fi

          if [ -z "$PR_NUMBER" ]; then
            echo "No PR number available. If running manually, pass 'pr_number' as workflow input." >&2
            exit 1
          fi

          echo "Fetching PR node id for #${PR_NUMBER}..."
          # Build GraphQL payloads with jq to avoid shell interpolation issues
          PAYLOAD_PR=$(jq -n --arg owner "$REPO_OWNER" --arg name "$REPO_NAME" --argjson number "$PR_NUMBER" '{query: "query($owner:String!,$name:String!,$number:Int!){repository(owner:$owner,name:$name){pullRequest(number:$number){id}}}", variables: {owner: $owner, name: $name, number: $number}}')
          PR_ID=$(curl -s -H "Authorization: Bearer $GITHUB_TOKEN" -X POST "$GITHUB_API" -d "$PAYLOAD_PR" | jq -r '.data.repository.pullRequest.id')
          if [ -z "$PR_ID" ] || [ "$PR_ID" = "null" ]; then
            echo "Could not fetch PR id. Full response:" >&2
            echo "$PR_ID" >&2
            exit 1
          fi
          echo "PR node id: $PR_ID"

          echo "Enabling auto-merge (SQUASH) on PR #${PR_NUMBER}..."
          PAYLOAD_ENABLE=$(jq -n --arg prId "$PR_ID" '{query: "mutation($prId:ID!){enablePullRequestAutoMerge(input:{pullRequestId:$prId,mergeMethod:SQUASH}){clientMutationId}}", variables: {prId: $prId}}')
          ENABLE_RESP=$(curl -s -H "Authorization: Bearer $GITHUB_TOKEN" -X POST "$GITHUB_API" -d "$PAYLOAD_ENABLE")
          echo "Response: $ENABLE_RESP"
          echo "Done."
