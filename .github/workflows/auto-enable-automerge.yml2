name: Enable Auto-Merge on New PRs

on:
  pull_request:
    types: [opened, reopened, ready_for_review, synchronize]
  check_suite:
    types: [completed]

permissions:
  pull-requests: write

jobs:
  enable-auto-merge:
    runs-on: ubuntu-latest
    steps:
      - name: Enable auto-merge (squash)
        uses: actions/github-script@v7
        with:
          github-token: ${{ secrets.GITHUB_TOKEN }}
          script: |
            const owner = context.repo.owner;
            const repo = context.repo.repo;

            // Determine PR number depending on event (pull_request or check_suite)
            let pr = null;
            if (context.payload.pull_request && context.payload.pull_request.number) {
              pr = context.payload.pull_request.number;
            } else if (context.payload.check_suite && Array.isArray(context.payload.check_suite.pull_requests) && context.payload.check_suite.pull_requests.length) {
              pr = context.payload.check_suite.pull_requests[0].number;
            }

            if (!pr) {
              console.log('No associated PR found for this event — nothing to do.');
              return;
            }

            const maxAttempts = 6;
            const delayMs = 10000; // 10s between checks
            let lastState = 'unknown';

            for (let attempt = 1; attempt <= maxAttempts; attempt++) {
              try {
                const { data: prData } = await github.rest.pulls.get({ owner, repo, pull_number: pr });
                const mergeable = prData.mergeable; // true/false/null
                const mergeable_state = prData.mergeable_state; // 'clean', 'dirty', etc.
                lastState = `mergeable=${mergeable} mergeable_state=${mergeable_state}`;
                console.log(`Attempt ${attempt}/${maxAttempts}: ${lastState}`);

                // Consider PR ready when GitHub reports mergeable true or mergeable_state === 'clean'
                if (mergeable === true || mergeable_state === 'clean') {
                  try {
                    await github.request('PUT /repos/{owner}/{repo}/pulls/{pull_number}/auto-merge', {
                      owner,
                      repo,
                      pull_number: pr,
                      merge_method: 'squash'
                    });
                    console.log(`Enabled auto-merge (squash) on PR #${pr}`);
                    return;
                  } catch (err) {
                    // Log full error for diagnosis
                    try {
                      console.log('Enable request failed (full):', JSON.stringify(err, Object.getOwnPropertyNames(err)));
                    } catch (e) {
                      console.log(`Enable request failed: ${err.message}`);
                    }

                    // Try GraphQL fallback using the PR node id (node_id is in prData.node_id)
                    try {
                      const prNodeId = prData.node_id || null;
                      if (prNodeId) {
                        console.log(`Attempting GraphQL fallback with PR node id ${prNodeId}`);
                        const gql = `mutation($prId:ID!){enablePullRequestAutoMerge(input:{pullRequestId:$prId,mergeMethod:SQUASH}){clientMutationId}}`;
                        await github.graphql(gql, { prId: prNodeId });
                        console.log(`Enabled auto-merge via GraphQL on PR #${pr}`);
                        return;
                      } else {
                        console.log('No PR node id available for GraphQL fallback.');
                      }
                    } catch (gerr) {
                      console.log('GraphQL fallback failed:', gerr.message || JSON.stringify(gerr));
                    }
                    // continue to retry in case of transient API errors or until fallback succeeds
                  }
                } else {
                  console.log('PR not mergeable yet.');
                }
              } catch (err) {
                console.log(`Error checking PR status: ${err.message}`);
              }

              if (attempt < maxAttempts) {
                console.log(`Waiting ${delayMs / 1000}s before retrying...`);
                await new Promise(resolve => setTimeout(resolve, delayMs));
              }
            }

            console.log(`Could not enable auto-merge on PR #${pr} after ${maxAttempts} attempts.`);

            // Post a comment on the PR to surface the failure and last-known mergeable state
            try {
              const body = `Automated auto-merge could not be enabled after ${maxAttempts} attempts. Last observed: ${lastState}. Please ensure required checks have completed successfully.`;
              await github.rest.issues.createComment({ owner, repo, issue_number: pr, body });
              console.log(`Posted comment to PR #${pr}`);
            } catch (err) {
              console.log(`Failed to post comment to PR #${pr}: ${err.message}`);
            }
