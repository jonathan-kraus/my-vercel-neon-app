##############################################
# Example environment variables for this app #
##############################################

# --- Database (Prisma / Neon) ---
# Obtain a connection string for your database from the Neon Dashboard.
# Format: postgres://user:pass@host/db
DATABASE_URL=

# Optional: surface the region in the UI (DbStatus component)
NEXT_PUBLIC_DB_REGION=

# Optional: Neon API key for consumption metrics (requires Scale, Business, or Enterprise plan)
# Get from: https://console.neon.tech/app/settings#api-keys
NEON_API_KEY=

# --- Base URLs ---
# Public base URL used in the browser; include scheme and no trailing slash
# Example (local): http://localhost:3000
NEXT_PUBLIC_SITE_URL=

# Server-side base URL fallback used by server utilities/routes.
# Usually set to the same value as NEXT_PUBLIC_SITE_URL for local usage.
SITE_URL=

# Set automatically by Vercel at runtime; do not set locally.
# Left here for reference only.
# VERCEL_URL=

# --- Email Providers ---
# MailerSend API key (current sender)
MAILERSEND_API_KEY=

# Resend API key (optional; only if you switch to Resend utilities)
RESEND_API_KEY=

# --- Email throttling ---
# Minutes to suppress duplicate/similar outgoing emails (default 15 if unset)
EMAIL_THROTTLE_MINUTES=15

# --- Weather (Tomorrow.io) ---
# Required for weather endpoints/features
TOMORROW_API_KEY=

# Optional ZIP override used in some logs or examples
JZIP=
ZIP_CODE=

# --- Node/Next diagnostics (optional) ---
# NODE_ENV=development

# --- Cron Security ---
# Secret token for protecting cron endpoints (like /api/neon/record-slow-queries)
# Generate a random string and add to Vercel environment variables
CRON_SECRET=your-secure-cron-secret-here


# Notes:
# - Copy this file to .env (or .env.local) and fill in values for local dev.
# - For Vercel, add the same keys in Project Settings → Environment Variables.
# - Do not commit your real secrets.
