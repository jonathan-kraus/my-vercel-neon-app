// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  name      String?
  posts     Post[]
}

model Post {
  id        Int      @id @default(autoincrement())
  title     String
  content   String
  published Boolean  @default(false)
  createdAt DateTime @default(now())
  authorId  Int
  author    User     @relation(fields: [authorId], references: [id])
  needsFollowUp Boolean @default(false)
  followUpDate DateTime?
  followUpNotes String?
}

model WeatherLog {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  temperature Float
  humidity    Float
  windSpeed   Float
  windGust    Float
  precipitationProbability Float
  weatherCode Int
  emailSent   Boolean @default(false)
  requestId   String?  // 👈 optional trace ID
  location    String?  // 👈 location identifier (e.g., "kop", "new_york")
}

model Log {
  id        String   @id @default(uuid())
  severity  String
  source    String   
  message   String
  requestId String?
  metadata  Json?
  timestamp DateTime @default(now())
}

model FeatureFlag {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  enabled     Boolean  @default(false)
  description String?
  category    String?  // e.g., "weather", "logging", "admin", "email", "ui", "performance", "location"
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())
}

model SlowQueryHistory {
  id          Int      @id @default(autoincrement())
  queryHash   String @db.Char(16) @unique
  query       String   // full query text
  meanTime    Float?   // mean execution time in ms
  calls       BigInt?  // number of calls
  durationMs  Float?   // duration (alternative metric)
  source      String?  // 'pg_stat_statements' or 'explain_analyze'
  timestamp   DateTime @default(now())
  requestId   String?  // trace ID

  @@index([queryHash, timestamp])
  @@index([timestamp])
}

model WeatherCache {
  id                       Int      @id @default(autoincrement())
  location                 String   // location identifier (e.g., "kop", "new_york")
  temperature              Float
  feelsLike                Float
  humidity                 Float
  windSpeed                Float
  windGust                 Float
  precipitationProbability Float
  pressure                 Float?
  visibility               Float?
  weatherCode              Int
  rainAccumulationAvg      Float
  rainAccumulationMax      Float
  rainAccumulationMin      Float
  rainAccumulationSum      Float
  locationDetails          Json     // detailed location info from Nominatim
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  @@unique([location])
  @@index([location, updatedAt])
}

model WeatherHourly {
  id                       Int      @id @default(autoincrement())
  location                 String
  forecastTime             DateTime
  temperature              Float
  feelsLike                Float
  humidity                 Float
  windSpeed                Float
  windGust                 Float
  precipitationProbability Float
  pressure                 Float?
  visibility               Float?
  weatherCode              Int
  rainAccumulationAvg      Float
  rainAccumulationMax      Float
  rainAccumulationMin      Float
  rainAccumulationSum      Float
  locationDetails          Json
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  @@unique([location, forecastTime])
  @@index([location, forecastTime])
  @@index([location, updatedAt])
}
