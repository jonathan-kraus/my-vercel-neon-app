{
  "crons": [
    {
      "path": "/api/weather",
      "schedule": "0 18 * * *"
    },
    {
      "path": "/api/neon/record-slow-queries",
      "schedule": "0 21 * * *"
    }
  ],
  "headers": [
    {
      "source": "/_next/static/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31535000, immutable"
        }
      ]
    }
  ]
}
